#!/bin/sh
# Drop extra Co-authored-by trailers so the commit author stays the local user.
msg_file=$1
sed -i '/^[Cc]o-[Aa]uthored-by:.*\(Cursor\|Claude\|ChatGPT\|cursoragent\|anthropic\)/Id' "$msg_file"
# Remove trailing blank lines left behind
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$msg_file" 2>/dev/null || true
